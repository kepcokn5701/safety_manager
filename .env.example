# ==============================================
# Safety Manager 환경 설정
# 다른 PC에서 사용 시: 이 파일을 .env로 복사
#   copy .env.example .env
# ==============================================

# 서버 설정
APP_HOST=0.0.0.0
APP_PORT=8000
APP_ENV=development

# 데이터베이스 - 로컬 SQLite (영구 보존)
DATABASE_URL=sqlite+aiosqlite:///./safety_mgr.db

# 알림 채널: "web_push" | "kakao" | "console"
NOTIFICATION_CHANNEL=web_push

# 웹 푸시 (VAPID 키) - python generate_vapid.py 로 생성
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=safety@kepco.co.kr

# 카카오 map API (주소 → 좌표 변환)
KAKAO_REST_API_KEY=
KAKAO_JAVA_SCRIPT_KEY=

# 기상청 API (기상청 API허브 인증키)
KMA_API_KEY=

# 기상 모니터링 설정
WEATHER_CHECK_INTERVAL_MINUTES=15

# NHN Cloud SMS (법인카드 등록 후 사용)
SMS_APP_KEY=
SMS_SECRET_KEY=
SMS_SENDER_PHONE=

# 로깅
LOG_LEVEL=INFO
