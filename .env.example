# ==============================================
# Safety Manager 환경 설정
# 이 파일을 복사하여 .env 파일을 만드세요
# cp .env.example .env
# ==============================================

# 서버 설정
APP_HOST=0.0.0.0
APP_PORT=8000
APP_ENV=development

# 데이터베이스 (SQLite → 사내망 이관 시 PostgreSQL로 변경)
# SQLite (기본)
DATABASE_URL=sqlite+aiosqlite:///./safety_manager.db
# PostgreSQL (사내망 이관 시)
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/safety_manager

# 알림 채널 선택: "web_push" | "kakao" | "console"
NOTIFICATION_CHANNEL=web_push

# 웹 푸시 (VAPID 키) - python generate_vapid.py 로 생성
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=safety@kepco.co.kr

# 카카오 알림톡 API (고도화 시 사용)
KAKAO_REST_API_KEY=your_kakao_rest_api_key_here
KAKAO_SENDER_KEY=your_sender_key_here
KAKAO_TEMPLATE_CODE_CAUTION=heat_caution
KAKAO_TEMPLATE_CODE_WARNING=heat_warning
KAKAO_TEMPLATE_CODE_DANGER=heat_danger

# 기상 모니터링 설정
WEATHER_CHECK_INTERVAL_MINUTES=15
DEFAULT_LATITUDE=37.5665
DEFAULT_LONGITUDE=126.9780

# 로깅
LOG_LEVEL=INFO
