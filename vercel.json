{
    "version": 2,
    "builds": [
        {
            "src": "api/index.py",
            "use": "@vercel/python",
            "config": {
                "maxLambdaSize": "50mb"
            }
        },
        {
            "src": "frontend/**",
            "use": "@vercel/static"
        }
    ],
    "routes": [
        {
            "src": "/static/(.*)",
            "dest": "frontend/$1"
        },
        {
            "src": "/sw.js",
            "dest": "frontend/sw.js"
        },
        {
            "src": "/(.*)",
            "dest": "api/index.py"
        }
    ]
}
